# .env.example — Copy to .env and fill in values (do NOT commit .env to git)

# HuggingFace token (only needed for gated models)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: Override default HuggingFace cache directory
# HF_HOME=C:\Users\Hp\.cache\huggingface

# Optional: Project root (auto-detected from config.py, override if needed)
# PROJECT_ROOT=C:\Users\Hp\OneDrive\Desktop\DEEP SPEECH PROCESSSING
